---
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import type { WorkProject } from "../data/work";
import "../styles/work.css";

interface Props {
  project: WorkProject;
  headingLevel?: "h2" | "h3";
  /** Rendered width hint; the default matches the two-column work index. */
  sizes?: string;
}

const { project, headingLevel = "h2", sizes = "(max-width: 700px) 100vw, 50vw" } = Astro.props;
const Heading = headingLevel;
---

<article class="work-card">
  <div class="work-preview">
    <Image src={project.preview} alt={project.previewAlt} widths={[480, 800, 1200]} sizes={sizes} format="webp" loading="lazy" />
    <span class="work-preview-label" aria-hidden="true">Read project <Icon name="arrow-right" /></span>
  </div>
  <div class="work-card-copy">
    <p class="work-kind">{project.kind}</p>
    <Heading><a href={`/work/${project.slug}/`}>{project.title}</a></Heading>
    <p class="work-description">{project.description}</p>
    <p class="work-role">{project.role}</p>
    <p class="work-relationship">{project.relationship}</p>
  </div>
</article>
