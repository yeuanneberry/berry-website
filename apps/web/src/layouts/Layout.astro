---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Icon from "../components/Icon.astro";
import { getImage } from "astro:assets";
import portrait from "../assets/profile.png";
import { profile } from "../data/profile";
import { site, analyticsEnabled } from "../../site.config.mjs";

import pages from "../../page-metadata.json";
import socialImages from "../generated/social-images.json";
import { websiteSchema } from "../../seo.mjs";

interface Props { noindex?: boolean; }
const { noindex = false } = Astro.props;
const route = noindex ? "/404/" : Astro.url.pathname;
const metadata = pages[route as keyof typeof pages];
if (!metadata) throw new Error("Missing page metadata: " + route);
const title = metadata.title;
const card = socialImages[route as keyof typeof socialImages];
const canonical = site.url && !noindex ? new URL(Astro.url.pathname, site.url).href : undefined;
const socialImage = new URL(card.path, site.url ?? Astro.url.origin).href;
const favicon = await getImage({ src: portrait, width: 32, height: 32, format: "png" });
const touchIcon = await getImage({ src: portrait, width: 180, height: 180, format: "png" });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#191c1c" />
    <link rel="preload" href="/fonts/JetBrainsMono-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="description" content={metadata.description} />
    <meta name="robots" content={site.indexable && !noindex ? "index, follow" : "noindex, nofollow"} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/png" sizes="32x32" href={favicon.src} />
    <link rel="apple-touch-icon" sizes="180x180" href={touchIcon.src} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Yeuanne Berry" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metadata.description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={card.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={metadata.title} />
    <meta name="twitter:description" content={metadata.description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={card.alt} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {route === "/" && websiteSchema && <script type="application/ld+json" is:inline set:html={websiteSchema} />}
  </head>
  <body data-analytics-enabled={String(analyticsEnabled)} data-analytics-origin={site.url} data-analytics-page={metadata.id}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <slot />
    <footer class="site-footer shell">
      <p>Yeuanne Berry</p>
      <nav aria-label="Elsewhere">
        <a href="/privacy/">Privacy</a>
        <a href={profile.github} data-stats-target="github-profile" target="_blank" rel="noopener noreferrer">GitHub <Icon name="external" size={14} /><span class="sr-only"> (opens in a new tab)</span></a>
        <a href={profile.studio} data-stats-target="studio" target="_blank" rel="noopener noreferrer">Yappers <Icon name="external" size={14} /><span class="sr-only"> (opens in a new tab)</span></a>
      </nav>
    </footer>
  </body>
</html>

<script>
  import "../scripts/menu-motion";
  import "../scripts/analytics";
</script>
