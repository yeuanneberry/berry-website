---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import "../styles/portfolio.css";

const destinations = [
  ["Home", "/", "Back to the start."],
  ["Work", "/work/", "Selected projects."],
  ["Code", "/code/", "Public repositories."],
  ["About", "/about/", "Who I am."],
];
---

<Layout noindex>
  <main id="main-content" class="shell missing-page" tabindex="-1">
    <header class="missing-intro">
      <p class="eyebrow">Error 404</p>
      <h1>Page not found</h1>
      <p class="missing-note">The address may have changed.</p>
    </header>
    <nav class="path-links missing-links" aria-label="Suggested pages">
      {destinations.map(([label, href, note]) => <a href={href}><h2>{label}</h2><p>{note}</p><b aria-hidden="true"><Icon name="arrow-right" /></b></a>)}
    </nav>
  </main>
</Layout>

<style>
  .missing-page { padding-block: 5rem; }
  .missing-intro { margin-bottom: 2.5rem; }
  .missing-intro h1 { margin-bottom: 1rem; }
  .missing-note { color: var(--muted); margin: 0; }
  .missing-links { grid-template-columns: repeat(4, minmax(0, 1fr)); margin-top: 0; }
  @media (max-width: 1000px) { .missing-links { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 700px) { .missing-page { padding-block: 3rem; } }
  @media (max-width: 480px) { .missing-links { grid-template-columns: minmax(0, 1fr); } }
</style>
